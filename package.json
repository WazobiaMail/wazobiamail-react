{
  "name": "wazobiamail-react",
  "version": "0.1.0",
  "description": "Official React 18/19 hooks, Context Provider, and React Email helpers for the WazobiaMail API",
  "keywords": [
    "wazobiamail",
    "react",
    "react-email",
    "email",
    "transactional",
    "smtp",
    "hooks",
    "sdk",
    "typescript"
  ],
  "homepage": "https://wazobiamail.com",
  "bugs": "https://github.com/WazobiaMail/wazobiamail-react/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/WazobiaMail/wazobiamail-react.git"
  },
  "license": "MIT",
  "author": "Bowofade Oyerinde <info@bonifadetechnologies.com> (https://github.com/WazobiaMail)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun test"
  },
  "dependencies": {
    "wazobiamail": "^0.1.0"
  },
  "peerDependencies": {
    "@react-email/render": ">=0.0.10",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^17.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2"
  }
}
